<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Efek Glow Luar -->
    <item>
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="4dp" android:color="#88FFFFFF" />
        </shape>
    </item>
    <!-- Garis Gradasi Dalam -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <corners android:radius="10dp" />
            <gradient android:startColor="#FFFFFF" android:endColor="#555555" android:angle="45" />
        </shape>
    </item>
    <!-- Latar Belakang Hitam -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape>
            <corners android:radius="9dp" />
            <solid android:color="#050505" />
        </shape>
    </item>
</layer-list>
