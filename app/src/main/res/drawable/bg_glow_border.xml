<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#88FFFFFF" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <corners android:radius="10dp" />
            <gradient android:startColor="#FFFFFF" android:centerColor="#8B4513" android:endColor="#333333" android:angle="45" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape>
            <corners android:radius="9dp" />
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
</layer-list>
