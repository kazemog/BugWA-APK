<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Garis luar gradasi -->
    <item>
        <shape>
            <corners android:radius="50dp" />
            <gradient android:startColor="#FFFFFF" android:centerColor="#888888" android:endColor="#222222" android:angle="45" />
        </shape>
    </item>
    <!-- Isi dalam (hitam) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <corners android:radius="48dp" />
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
</layer-list>
