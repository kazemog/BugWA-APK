<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_bg"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KAZE BUG"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#FF0000"
            android:shadowRadius="10"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:id="@+id/bannerImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_glow_border"
            android:padding="3dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_glow_border"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            
            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_glow_border"
                android:layout_marginRight="12dp" />
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAZE MORALES" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFF" android:fontFamily="sans-serif-black" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VVIP ACCESS" android:textSize="12sp" android:textStyle="bold" android:textColor="#FF3333" android:fontFamily="sans-serif-black" />
            </LinearLayout>
            
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textStyle="bold" android:textColor="#00FF41" android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET WHATSAPP" android:textColor="#FFF" android:textStyle="bold" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp" />
        
        <EditText
            android:id="@+id/targetNum"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="CONTOH : 628XXXXXXXXX"
            android:textColorHint="#888"
            android:textColor="#FFF"
            android:textStyle="bold"
            android:background="@drawable/bg_glow_border"
            android:padding="15dp"
            android:inputType="phone"
            android:layout_marginBottom="20dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PILIH METODE BUG" android:textColor="#FFF" android:textStyle="bold" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:scrollbars="none">
            
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                
                <LinearLayout android:id="@+id/bugCrash" android:layout_width="120dp" android:layout_height="110dp" android:background="@drawable/bg_bug_active" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💥" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRASH" android:textSize="12sp" android:textStyle="bold" android:textColor="#FF3333" android:fontFamily="sans-serif-black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FC WA Target" android:textSize="9sp" android:textColor="#AAA" />
                </LinearLayout>

                <LinearLayout android:id="@+id/bugDelay" android:layout_width="120dp" android:layout_height="110dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏳" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DELAY" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFB800" android:fontFamily="sans-serif-black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spam Lag" android:textSize="9sp" android:textColor="#AAA" />
                </LinearLayout>

                <LinearLayout android:id="@+id/bugFreeze" android:layout_width="120dp" android:layout_height="110dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄️" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FREEZE" android:textSize="12sp" android:textStyle="bold" android:textColor="#00F0FF" android:fontFamily="sans-serif-black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bekukan Layar" android:textSize="9sp" android:textColor="#AAA" />
                </LinearLayout>

                <LinearLayout android:id="@+id/bugQuota" android:layout_width="120dp" android:layout_height="110dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📁" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUOTA" android:textSize="12sp" android:textStyle="bold" android:textColor="#B026FF" android:fontFamily="sans-serif-black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full Memori" android:textSize="9sp" android:textColor="#AAA" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="SEND BUG"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFF"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_glow_border"
            android:layout_marginBottom="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SENDER TYPE" android:textColor="#FFF" android:textStyle="bold" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp" />
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnPublic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="PUBLIC" android:textStyle="bold" android:textColor="#FFF" android:fontFamily="sans-serif-black" android:background="@drawable/bg_bug_inactive" android:layout_marginRight="4dp" />
            <Button android:id="@+id/btnPrivate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="PRIVATE" android:textStyle="bold" android:textColor="#FFF" android:fontFamily="sans-serif-black" android:background="@drawable/bg_bug_inactive" android:layout_marginLeft="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnManageSender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="MANAGE SENDER"
            android:textStyle="bold"
            android:textColor="#FFF"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_glow_border"
            android:layout_marginBottom="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAZE TERMINAL LOG" android:textColor="#FFF" android:textStyle="bold" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp" />
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_glow_border"
            android:padding="10dp">
            <TextView
                android:id="@+id/terminalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[SYSTEM] Initializing Kaze Core...\n[SYSTEM] Bypass Security... OK\n[SYSTEM] Waiting for target..."
                android:textColor="#D2B48C"
                android:fontFamily="monospace"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
