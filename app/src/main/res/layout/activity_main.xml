<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    
    <com.kaze.bugwa.MatrixRainView android:layout_width="match_parent" android:layout_height="match_parent" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KAZE BUG" android:textSize="36sp" android:textStyle="bold" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:shadowColor="#00FF41" android:shadowRadius="10" android:layout_marginBottom="12dp" />

            <ImageView android:id="@+id/bannerImage" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerCrop" android:background="@drawable/bg_glow_border" android:padding="3dp" android:layout_marginBottom="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glow_border" android:padding="12dp" android:gravity="center_vertical" android:layout_marginBottom="20dp">
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_circle_glow" android:layout_marginRight="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAZE MORALES" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVELOPER" android:textSize="12sp" android:textStyle="bold" android:textColor="#00FF41" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textStyle="bold" android:textColor="#00FF41" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET WHATSAPP" android:textColor="#FFF" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <EditText android:id="@+id/targetNum" android:layout_width="match_parent" android:layout_height="60dp" android:hint="628XXXXXXXXX" android:textColor="#FFF" android:background="@drawable/bg_glow_border" android:padding="15dp" android:inputType="phone" android:layout_marginBottom="20dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PILIH METODE BUG" android:textColor="#FFF" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/bugCrash" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_active" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💥" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRASH" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:id="@+id/bugDelay" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏳" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DELAY" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:id="@+id/bugFreeze" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄️" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FREEZE" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:id="@+id/bugQuota" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📁" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUOTA" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:id="@+id/bugVirus" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🦠" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VIRUS" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:id="@+id/bugCall" android:layout_width="110dp" android:layout_height="100dp" android:background="@drawable/bg_bug_inactive" android:orientation="vertical" android:gravity="center" android:layout_marginRight="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📞" android:textSize="24sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CALL" android:textColor="#FFF"/></LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="70dp" android:text="SEND BUG" android:textSize="24sp" android:textStyle="bold" android:textColor="#00FF41" android:fontFamily="sans-serif-black" android:background="@drawable/bg_glow_button" android:layout_marginBottom="20dp" />

            <Button android:id="@+id/btnTutorial" android:layout_width="match_parent" android:layout_height="50dp" android:text="CARA PAKAI" android:textColor="#FFF" android:background="@drawable/bg_glow_border" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
