    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Aktifkan Aksesibilitas di HP.\n2. Masukkan nomor target.\n3. Pilih metode bug.\n4. Klik SEND BUG." android:textColor="#FFF" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginBottom="20dp"/>
    <Button android:id="@+id/btnTutupTutorial" android:layout_width="match_parent" android:layout_height="50dp" android:text="MENGERTI" android:textStyle="bold" android:textColor="#000" android:backgroundTint="#00FF41"/>
